{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANKA Next operator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "players",
    "mission"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "role": {
            "enum": [
              "leader",
              "follower"
            ]
          }
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "min_monsters",
        "max_monsters",
        "target_wins",
        "max_attempts",
        "stop_on_loss",
        "stop_on_unknown"
      ],
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "min_monsters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_monsters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "target_wins": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "stop_on_loss": {
          "type": "boolean"
        },
        "stop_on_unknown": {
          "type": "boolean"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server_ports": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "interface": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 255
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "save_raw_evidence": {
          "type": "boolean"
        }
      }
    }
  },
  "$comment": "Cross-field rules (leader uniqueness and min<=max) are enforced in anka_app.configuration."
}
